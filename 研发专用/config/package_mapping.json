    {"keyword": "g6",            "type": "full", "target_dir": ""},
    {"keyword": "env_model",     "type": "app",  "target_dir": "env_model"},
    {"keyword": "odometry",      "type": "app",  "target_dir": "odometry"},
    {"keyword": "encryption",    "type": "app",  "target_dir": "encryption"},
    {"keyword": "trigger",       "type": "app",  "target_dir": "trigger"},
    {"keyword": "fsd_control",   "type": "app",  "target_dir": "fsd_control"},
    {"keyword": "guard",         "type": "app",  "target_dir": "guard"},
    {"keyword": "dsp",           "type": "app",  "target_dir": "dsp"},
    {"keyword": "ipcf_proxy",    "type": "app",  "target_dir": "ipcf_proxy"},
    {"keyword": "para_check",    "type": "app",  "target_dir": "para_check"},
    {"keyword": "planning_node", "type": "app",  "target_dir": "planning_node"},
    {"keyword": "system_monitor","type": "app",  "target_dir": "system_monitor"},
    {"keyword": "dpsm",          "type": "app",  "target_dir": "dpsm"},
    {"keyword": "perception",    "type": "app",  "target_dir": "adas"},
