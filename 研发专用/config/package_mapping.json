  "ip_mapping": [
    {"local_ip": "172.31.48.102",  "target_ip": "172.31.48.9"},
    {"local_ip": "192.168.2.102",  "target_ip": "192.168.2.62"},
    {"local_ip": "172.20.1.102",   "target_ip": "172.20.1.22"},
